    "test:e2e": "electron-vite build && playwright test"
  },
  "dependencies": {
    "pino": "10.3.1",
    "playwright-core": "1.63.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tabreach/browser-worker": "workspace:*",
    "@tabreach/core": "workspace:*",
    "@tabreach/fixture-sites": "workspace:*",
    "@tabreach/protocol": "workspace:*",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "electron": "44.4.5",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "vite": "7.3.6",
    "zod": "4.6.5"
  }
