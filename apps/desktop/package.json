{
  "name": "@tabreach/desktop",
  "productName": "TabReach",
  "version": "0.0.1",
  "description": "Local-only outreach browser",
  "author": "TabReach",
  "private": true,
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
